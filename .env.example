# --- Core -------------------------------------------------------------------
BRAIN_PATH=/path/to/the-brain
# Ingestion state directory (processed/, pivots/, covers/). Required, outside
# the repository; it must already exist - the tools never create it.
STATE_PATH=
AUTO_ROUTE=false

# --- Speech to text ---------------------------------------------------------
# local = faster-whisper on this machine (default): no key, no quota, offline.
# groq  = Groq Whisper API, needs GROQ_API_KEY below.
STT_BACKEND=local

# Local backend. Empty values fall back to the defaults shown in comments.
WHISPER_MODEL=            # large-v3-turbo
WHISPER_DEVICE=           # auto | cuda | cpu   (auto: CUDA if enough VRAM)
WHISPER_COMPUTE_TYPE=     # int8_float16 on CUDA, int8 on CPU
WHISPER_VRAM_MIN_MB=      # 1800 - below this much free VRAM, auto picks CPU
WHISPER_CPU_THREADS=      # 4 - the CPU fallback also drops process priority

# GPU needs the CUDA runtime ctranslate2 does not ship:
#   pip install -e ".[cuda]"
# Without it the local backend still works, on CPU, roughly 10x slower.

# Groq backend only.
GROQ_API_KEY=
